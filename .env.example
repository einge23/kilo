# Local development only. Copy to .env and choose a password without semicolons.
POSTGRES_PASSWORD=replace-with-a-local-password

# Public Clerk configuration; use your frontend API issuer and browser origin.
CLERK_ISSUER=https://your-instance.clerk.accounts.dev
CLERK_AUTHORIZED_PARTY=http://localhost:3000
# Optional audience: set Clerk__Audience in the API environment when your tokens define aud.
